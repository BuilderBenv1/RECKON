# Airwallex sandbox (Account > Developer > API keys, a scoped key). Never commit real values.
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com

# Anthropic API key: Claude reads emails and drafts supplier/customer messages.
# Leave blank to use the deterministic fixture reader and the message templates.
ANTHROPIC_API_KEY=

# ---- web app (Vercel) ----
# Supabase project (run supabase/migrations 0001 to 0004 in order first). Without these,
# runs live in server memory: fine for `npm run dev`, not for Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Code people must enter to start a live sandbox run from the web app. Several codes can be
# given separated by commas (e.g. your own and one for judges), so one can be withdrawn alone.
RECKON_LIVE_CODE=
# Secret of the Airwallex webhook pointing at /api/webhooks/airwallex.
AIRWALLEX_WEBHOOK_SECRET=
# Set to 1 to let public demo runs use Claude, which turns on "Write your own email" (16 calls a run).
RECKON_DEMO_CLAUDE=
# Optional. Vercel sends it to /api/cron/keepalive (the daily ping that stops Supabase pausing).
CRON_SECRET=
# Optional: a human voice for the guided demo (ElevenLabs). Each line is voiced once and cached
# in the Supabase `narration` bucket (migration 0002). Without a key the browser's voice is used.
ELEVENLABS_API_KEY=
# Optional. Defaults to "George" (JBFqnCBsd6RMkjVDRZzb) on eleven_v4; eleven_multilingual_v2 also works.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Optional, 0 to 1. Unset uses the voice's own settings; lower sounds more expressive.
ELEVENLABS_STABILITY=
# Optional. The guided demo ends "I'll hand you over to <name>." when the page is opened with ?handoff.
RECKON_PRESENTER=
