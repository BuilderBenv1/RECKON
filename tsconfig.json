{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "scripts", "test", "app", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
